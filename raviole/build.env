# Kernel build configuration — uncomment and edit to override defaults.
#
# NOTE: All values shown here are the DEFAULTS defined in build.sh.
# Uncommenting a line overrides that default for local builds only.
# (Keep this file in sync with build.sh if you change a default there.)

# Device config
# ZIPNAME="86hm"
# DEVICE="gs101"
# DEFCONFIG="raviole_defconfig"
# KERNEL_IMAGE="Image.lz4"
# DTB_FILES="gs101-a0.dtb gs101-b0.dtb"

# Toolchain: clang or gcc
# TOOLCHAIN="clang"

# Pin a specific LLVM version for clang builds (e.g. "19.1.0").
# Empty = use latest available from kernel.org.
# LLVM_VERSION=""

# Clang hardening features (auto-enabled when TOOLCHAIN=clang && RELEASE=1):
#   CONFIG_CFI_CLANG, CONFIG_SHADOW_CALL_STACK, CONFIG_LTO_CLANG_FULL
#   (CONFIG_LTO_CLANG_THIN is disabled to make LTO_FULL stick)
# No manual override needed — controlled by TOOLCHAIN and RELEASE flags.

# AnyKernel3
# AK3_REPO="Reinazhard/AnyKernel3"

# KernelSU (used when KSU=1)
# KSU_REPO="Reinazhard/KernelSU"
# KSU_BRANCH="fork"

# Build behavior (0 or 1)
# CLEAN=0
# SIGN=0
# NOTIFY=0
# LOG=0
# RELEASE=0
# KSU=0
# CI=0

# Telegram
# CHATID="-1001403511595"

# Output directory
# OUT_DIR="out"

# Spoofed kernel build date (RELEASE/CI builds only)
# KBUILD_BUILD_TIMESTAMP="Wed Jan 28 05:34:14 UTC 2026"

# Spoofed build user and hostname
# KBUILD_BUILD_USER="build-user"
# KBUILD_BUILD_HOST="build-host"
